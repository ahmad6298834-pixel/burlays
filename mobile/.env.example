# Copy this file to `.env` and set it to your PERMANENT deployed production backend URL.
# This is the SAME backend/database used by the Admin Web Application.
#
# DO NOT use:
#   - localhost / 127.0.0.1              (not reachable from a real phone)
#   - http://10.0.2.2:3000               (Android-emulator-only alias)
#   - any *.e2b.app / "sandbox" URL       (temporary dev preview — WILL expire/disappear,
#                                          this exact mistake caused "Sandbox Not Found")
#
# DO use a real, permanent HTTPS domain from a host like Vercel, Railway, or Render, e.g.:
EXPO_PUBLIC_API_URL=https://your-production-domain.com

# Before building the APK, verify this URL is reachable with:
#   npm run verify-backend
